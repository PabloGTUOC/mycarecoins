# Copy to scripts/deploy.env and fill in. That file is gitignored — it names
# your server, so it stays out of the repo. It holds no passwords: the script
# authenticates with your normal SSH key.
#
# Used by scripts/deploy.sh. See docs/deployment-and-delivery.md §2.

# Where to ssh. An alias from ~/.ssh/config is better than user@host, because
# then the key, port and user live in one place:
#
#   Host carecoins
#     HostName 203.0.113.10
#     User pablo
#     IdentityFile ~/.ssh/id_ed25519
#
DEPLOY_HOST=carecoins

# The directory on the server holding docker-compose.yml — a git checkout of
# this repo.
DEPLOY_PATH=/srv/carecoins

# Extra ssh/scp flags, if you need them (a non-standard port, a jump host).
# DEPLOY_SSH_OPTS="-p 2222"

# Public URL, used only for the post-deploy probe.
DEPLOY_URL=https://mycarecoins.app

# Operator console URL (when deploying with --admin), used for post-deploy probe.
DEPLOY_ADMIN_URL=https://admin.mycarecoins.app

# Where backups are written on the server, before every deploy.
# DEPLOY_BACKUP_DIR=/srv/carecoins/backups

# Postgres credentials as set in docker-compose.yml. Override only if you
# changed them there.
# DEPLOY_PG_USER=carecoins
# DEPLOY_PG_DB=carecoins
