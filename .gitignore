node_modules/
.env
firebase-credentials.json

# IDE and Editor folders
.idea/
.claude/

# Logs
*.log

# OS generated files
.DS_Store

# Deploy target (names your server; never committed)
scripts/deploy.env

# Backups deploy.sh writes on the server before it changes anything. Untracked
# there, they made the next run's "server checkout is clean" gate fail.
/backups/

# Operator console secrets (docs/management-platform-plan.md); the
# .example templates are committed, the real files never are.
backend/admin.env
backend/admin-db.env
backend/tunnel.env

# Operator console Flutter artifacts
adminFront/.dart_tool/
adminFront/build/
adminFront/.flutter-plugins-dependencies
adminFront/.pub-cache/
adminFront/.pub/


# Apple private keys (APNs, In-App Purchase, App Store Connect API): never commit
*.p8
