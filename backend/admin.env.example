# Operator console API (admin-api) settings — docs/management-platform-plan.md §2.4.
# Copy to backend/admin.env on the server. Only the admin-api
# container reads it; the public backend never does. Never commit the real file.

# Cloudflare Access in front of admin.mycarecoins.app (required in production).
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Firebase project used to check operators' ID tokens.
FIREBASE_PROJECT_ID=

# Phase 3: RevenueCat REST API v2 (secret key). Leaving any empty turns the mirror off.
RC_SECRET_API_KEY=
RC_PROJECT_ID=
RC_ENTITLEMENT_ID=

# Phase 4: App Store Connect API (team key) and App Store Server API (In-App Purchase key).
# Note: Private key .p8 contents (ASC_PRIVATE_KEY and IAP_PRIVATE_KEY) go in as one line with \n escapes.
# Leaving any required key empty turns App Store integration off (endpoints answer 503 appStoreNotConfigured).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=
IAP_KEY_ID=
IAP_PRIVATE_KEY=
APP_BUNDLE_ID=com.carecoins.carecoinsFlutter

# Phase 3 part 4 (MP3d): Webhook re-process through public backend.
# Shared secret for internal calls. Must match backend/.env (e.g. openssl rand -hex 32).
# Leaving it unset turns webhook re-processing off (endpoints answer 503 reprocessNotConfigured).
INTERNAL_API_TOKEN=
INTERNAL_API_URL=http://backend:3000
