# Operator console API (admin-api) settings — docs/management-platform-plan.md §2.4.
# Copy to backend/admin.env on the server. Only the admin-api and cloudflared
# containers read it; the public backend never does. Never commit the real file.

# Cloudflare Access in front of admin.mycarecoins.app (required in production).
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Firebase project used to check operators' ID tokens.
FIREBASE_PROJECT_ID=

# Phase 2: Cloudflare Tunnel connector token (cloudflared).
CLOUDFLARE_TUNNEL_TOKEN=

# Phase 3: RevenueCat REST API v2 (secret key).
RC_SECRET_API_KEY=
RC_PROJECT_ID=
RC_ENTITLEMENT_ID=

# Phase 4: App Store Connect API (team key) and App Store Server API (In-App Purchase key).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=
IAP_KEY_ID=
IAP_PRIVATE_KEY=
APP_BUNDLE_ID=
