    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^12.5.0",
    "jose": "^6.2.12",
    "multer": "^2.1.1",
    "pg": "^8.12.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
