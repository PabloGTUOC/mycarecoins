{
  "name": "carecoins-backend",
  "version": "0.1.0",
  "description": "CareCoins backend API (initial implementation)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:test": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 node src/server.js",
    "db:init": "node scripts/init-db.js",
