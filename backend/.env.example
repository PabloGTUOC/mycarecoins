# Copy this file to backend/.env and fill in the real values.
#
# docker-compose.yml loads it for the backend service via
# `env_file: ./backend/.env`; `npm run dev` loads it through src/env.js.
# DATABASE_URL, PORT and NODE_ENV are also set directly in
# docker-compose.yml, and those win over anything written here — so the
# values below only take effect in local development.
#
# There is no longer a .env at the repo root: docker-compose.yml has no
# ${VAR} substitutions left, and the Flutter web app compiles its Firebase
# config in from lib/firebase_options.dart instead of reading VITE_* vars
# at build time.

# ── Database (local development; Docker overrides these) ────────────────────
DATABASE_URL=postgres://carecoins:carecoins@localhost:5433/carecoins
PGSSL=false
PORT=3000

# ── Firebase (server-side ID token verification) ────────────────────────────
# The service account JSON itself is NOT set here — it lives at the repo root
# as firebase-credentials.json and is mounted read-only into the container.
FIREBASE_PROJECT_ID=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins; there is no wildcard, including in dev.
# Only browsers send an Origin header, so the iOS and Android apps need no
# entry here. When running the web build locally, pin the port
# (`flutter run -d chrome --web-port=8080`) so it matches one of these.
ALLOWED_ORIGINS=http://localhost:8080,https://mycarecoins.app

# ── Email (Resend — resend.com) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=CareCoins <noreply@mycarecoins.app>
APP_URL=https://mycarecoins.app

# ── Billing (RevenueCat) ────────────────────────────────────────────────────
# The Authorization header value configured on the RevenueCat webhook
# (Project settings → Integrations → Webhooks). /api/billing/webhook answers
# 401 to any call whose header does not match, so if this is unset the app
# keeps working but store purchases never grant Pro to anyone.
REVENUECAT_WEBHOOK_SECRET=

# ── Internal API (MP3d) ─────────────────────────────────────────────────────
# Shared secret for internal calls between admin-api and the public backend
# (e.g. webhook re-process). Must match backend/admin.env.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Tests only ──────────────────────────────────────────────────────────────
# Points Firebase Admin at the local auth emulator (firebase.json, port 9099).
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

