<?xml version="1.0" encoding="utf-8"?>
<!-- One exact-sized widget: default 4x2 (wide layout); 2x2 is still allowed via minWidth/minHeight 110dp.
     updatePeriodMillis is 0 because WorkManager refreshes it (QuickRefreshWorker). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="530dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/quick_widget_preview"
    android:description="@string/widget_tasks_description"
    android:widgetCategory="home_screen" />
